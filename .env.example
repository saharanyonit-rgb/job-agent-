# Job Agent configuration template.
# Copy to `.env` (same directory you run the agent from) and fill in real values.
# All keys map 1:1 to job_agent/core/config.py Settings (pydantic-settings, case-insensitive).

# ---------- Database ----------
DATABASE_URL=sqlite:///./storage/job_agent.db

# ---------- AI providers (matching / answers / interview prep) ----------
# At least one provider key is needed for AI-assisted matching & answer generation.
# Without any key the system falls back to rule_based scoring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional local LLM (Ollama); leave base url empty to disable
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
LLM_PROVIDERS=openai,anthropic,ollama,rule_based

# ---------- Job discovery sources ----------
# JSearch (RapidAPI) adapter: unified Indeed/LinkedIn/Glassdoor search.
# Get a key at https://rapidapi.com/lucascesar-rafin-jsearch.p.rapidapi.com (JSearch subscription).
RAPIDAPI_KEY=

# ---------- OAuth (email inbox processing, calendar scheduling) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=

# ---------- Application policy ----------
# PREPARE_AND_APPROVE = human approval required before submit (safe default)
# AUTONOMOUS          = unattended submissions when all quality gates pass
APP_MODE=PREPARE_AND_APPROVE
MINIMUM_MATCH=80
MAX_DAILY_APPLICATIONS=20

# ---------- Quality gates ----------
MAX_APPLICATIONS_PER_COMPANY=3
MAX_APPLICATIONS_PER_ROLE=5
COMPANY_COOLDOWN_DAYS=30
MIN_EVIDENCE_CONFIDENCE=0.8
MAX_LOW_CONFIDENCE_APPLICATIONS=5
MAX_HARD_FAILURES=0

# ---------- Scheduler intervals (minutes) ----------
DISCOVER_INTERVAL_MINUTES=120
VERIFY_INTERVAL_MINUTES=240
FOLLOWUP_INTERVAL_MINUTES=1440

# ---------- Runtime ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
AGENT_ENABLED=true
BROWSER_HEADLESS=true
STORAGE_DIR=./storage

# Browser backend for form filling: auto | playwright | http
#   auto       -> Playwright when available, otherwise plain HTTP fallback
#   playwright -> require real Chromium (recommended for JS-heavy ATS forms)
#   http       -> no browser, simple HTML forms only
BROWSER_BACKEND=auto
